name: Build
on: [push]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
      - name: Download Numismatic Overhaul jar
        run: |
          mkdir -p libs
          curl -L "https://cdn.modrinth.com/data/OBi5hqTv/versions/numismatic-overhaul-0.3.5+1.21.jar" -o libs/numismatic-overhaul-0.3.5+1.21.jar
      - name: Build
        run: ./gradlew build
      - uses: actions/upload-artifact@v4
        with:
          name: waystonecoins
          path: build/libs/*.jar
